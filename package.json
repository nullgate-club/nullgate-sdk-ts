{
  "name": "@nullgate/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Nullgate SDK with local protection discovery and isolated generation sessions",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "examples",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.mjs",
    "check": "biome check . && npm run typecheck && npm run build && npm test",
    "prepare": "npm run build",
    "example": "node examples/target.ts"
  },
  "dependencies": {
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "wreq-js": "3.2.0"
  }
}
